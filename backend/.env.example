# ─── Telegram ────────────────────────────────────────────────
# Never share or commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AbdelhakPortfolioBot

# Your personal Telegram chat ID (receive lead alerts here).
# Find it by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_CHAT_ID=

# Secret path segment that protects the webhook endpoint.
# Generate any random string, e.g.: openssl rand -hex 20
WEBHOOK_SECRET=your_random_secret_here

# ─── AI Provider ─────────────────────────────────────────────
# OpenAI (recommended). Get a key at https://platform.openai.com
OPENAI_API_KEY=
# Model to use — gpt-4o is the best balance of quality & cost.
OPENAI_MODEL=gpt-4o

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Public URL where this backend is hosted (no trailing slash).
# Used to register the Telegram webhook automatically on startup.
BACKEND_URL=https://your-app.up.railway.app

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://abdelhakhaddani.github.io
